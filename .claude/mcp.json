{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "antigravity": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-server-google-antigravity"
      ],
      "env": {
        "AGY_AUTO_APPROVE": "true"
      }
    }
  }
}
