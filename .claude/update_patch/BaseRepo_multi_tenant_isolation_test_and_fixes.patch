diff --git a/CommonLibs/BaseSQL/multi-tenant/00_check_multi_site_users.sql b/CommonLibs/BaseSQL/multi-tenant/00_check_multi_site_users.sql
new file mode 100644
index 0000000..679f18a
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/00_check_multi_site_users.sql
@@ -0,0 +1,53 @@
+/*
+  Pre-flight check: rà soát dữ liệu tbl_User_Site TRƯỚC khi migrate sang mô hình
+  "1 User chỉ thuộc đúng 1 Site" (xem tài liệu thiết kế multi-tenant, mục 06 bước 1
+  - https://claude.ai/code/artifact/287ffb5c-0fc3-4fd0-81ec-a9f61d4e018b).
+
+  Không có lệnh ghi dữ liệu nào trong file này - chỉ SELECT để biết phạm vi ảnh hưởng.
+  Chạy trước khi chạy 01_add_siteid_to_users.sql, an toàn chạy lại nhiều lần.
+
+  Nếu phần 1 ("Users đang active ở nhiều Site") trả về > 0 dòng, PHẢI xử lý thủ công
+  trước khi migrate tiếp - thiết kế mới không cho phép 1 User thuộc nhiều Site cùng lúc.
+  Hai lựa chọn:
+    a) Giữ đúng 1 Site cho user đó - soft-delete (Status = -1) các dòng tbl_User_Site
+       còn lại TRƯỚC khi chạy 01_add_siteid_to_users.sql, để backfill tự động lấy đúng
+       Site còn active duy nhất.
+    b) Tách thành nhiều User riêng biệt (mỗi Site 1 tài khoản đăng nhập khác nhau) - cần
+       làm thủ công qua ứng dụng, ngoài phạm vi các script trong thư mục này.
+*/
+
+USE BaseRepo;
+GO
+
+-- 1) Users đang active (Status = 1) ở nhiều hơn 1 Site cùng lúc - cần xử lý trước khi
+--    migrate tiếp, xem hướng dẫn ở đầu file.
+SELECT
+    us.UserId
+    ,COUNT(*) AS ActiveSiteCount
+    ,STRING_AGG(us.SiteId, ', ') AS SiteIds
+FROM tbl_User_Site us
+WHERE us.[Status] = 1
+GROUP BY us.UserId
+HAVING COUNT(*) > 1
+ORDER BY ActiveSiteCount DESC;
+GO
+
+-- 2) Users chưa từng có dòng tbl_User_Site nào active (kể cả đã soft-delete) - backfill
+--    tự động ở 01_add_siteid_to_users.sql sẽ KHÔNG gán được SiteId cho những user này,
+--    cần gán tay trước khi chạy 02_finalize_users_siteid.sql (xem SELECT cuối file 01).
+SELECT u.UserId, u.UserName, u.[Status]
+FROM tbl_Users u
+WHERE NOT EXISTS (
+    SELECT 1 FROM tbl_User_Site us WHERE us.UserId = u.UserId AND us.[Status] = 1
+)
+ORDER BY u.UserId;
+GO
+
+-- 3) Tổng quan số lượng - lưu lại kết quả này để đối chiếu sau khi migrate xong
+--    (TotalUsers nên bằng tổng số dòng tbl_Users có SiteId sau khi hoàn tất 01+02).
+SELECT
+    (SELECT COUNT(*) FROM tbl_Users) AS TotalUsers
+    ,(SELECT COUNT(DISTINCT UserId) FROM tbl_User_Site WHERE [Status] = 1) AS UsersWithActiveSite
+    ,(SELECT COUNT(*) FROM tbl_Site) AS TotalSites
+    ,(SELECT COUNT(*) FROM tbl_Modules) AS TotalModules;
+GO
diff --git a/CommonLibs/BaseSQL/multi-tenant/01_add_siteid_to_users.sql b/CommonLibs/BaseSQL/multi-tenant/01_add_siteid_to_users.sql
new file mode 100644
index 0000000..0892db6
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/01_add_siteid_to_users.sql
@@ -0,0 +1,53 @@
+/*
+  Bước 1/2 gắn SiteId vào tbl_Users: thêm cột SiteId (nullable) + backfill từ tbl_User_Site.
+
+  Yêu cầu tiên quyết: đã chạy 00_check_multi_site_users.sql và xử lý xong mọi user đang
+  active ở nhiều Site cùng lúc (mục 1 của file đó). Nếu chưa xử lý, backfill bên dưới vẫn
+  chạy được nhưng sẽ TỰ CHỌN 1 trong các Site đang active cho user đó (theo AutoId nhỏ
+  nhất trong tbl_User_Site - coi như Site gán sớm nhất) - không chắc đúng ý nghiệp vụ,
+  nên xử lý xong bước rà soát trước khi chạy file này.
+
+  Cột để nullable ở bước này (chưa ép NOT NULL) để có thể chạy nhiều lần / sửa tay từng
+  user riêng lẻ (VD user ở mục 2 của 00_check_multi_site_users.sql - chưa có UserSite
+  active nào) trước khi khoá cứng ở 02_finalize_users_siteid.sql.
+*/
+
+USE BaseRepo;
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.columns
+    WHERE object_id = OBJECT_ID('dbo.tbl_Users') AND name = 'SiteId'
+)
+BEGIN
+    ALTER TABLE [dbo].[tbl_Users] ADD [SiteId] VARCHAR(20) NULL;
+END
+GO
+
+-- Backfill: mỗi User lấy Site đang active (Status = 1) có AutoId nhỏ nhất trong
+-- tbl_User_Site (nhỏ nhất = gán sớm nhất -> ưu tiên Site "gốc" nếu còn sót nhiều dòng
+-- active mà bước rà soát 00_check_multi_site_users.sql chưa kịp xử lý).
+;WITH PrimarySite AS (
+    SELECT
+        us.UserId
+        ,us.SiteId
+        ,ROW_NUMBER() OVER (PARTITION BY us.UserId ORDER BY us.AutoId ASC) AS rn
+    FROM tbl_User_Site us
+    WHERE us.[Status] = 1
+)
+UPDATE u
+SET u.SiteId = ps.SiteId
+FROM tbl_Users u
+INNER JOIN PrimarySite ps ON ps.UserId = u.UserId AND ps.rn = 1
+WHERE u.SiteId IS NULL;
+GO
+
+-- Users KHÔNG backfill được (không có tbl_User_Site active nào) - đối chiếu với mục 2
+-- của 00_check_multi_site_users.sql. Gán SiteId thủ công cho từng user ở đây trước khi
+-- chạy 02_finalize_users_siteid.sql, ví dụ:
+--   UPDATE tbl_Users SET SiteId = 'SITE001' WHERE UserId = 'admin' AND SiteId IS NULL;
+SELECT UserId, UserName, [Status]
+FROM tbl_Users
+WHERE SiteId IS NULL
+ORDER BY UserId;
+GO
diff --git a/CommonLibs/BaseSQL/multi-tenant/02_finalize_users_siteid.sql b/CommonLibs/BaseSQL/multi-tenant/02_finalize_users_siteid.sql
new file mode 100644
index 0000000..7434bd5
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/02_finalize_users_siteid.sql
@@ -0,0 +1,90 @@
+/*
+  Bước 2/2 gắn SiteId vào tbl_Users: khoá cứng NOT NULL, đổi UserId từ unique toàn cục
+  sang unique theo từng Site, xoá bảng trung gian tbl_User_Site.
+
+  ⚠️ Có DROP TABLE tbl_User_Site - thao tác phá huỷ. Chỉ chạy sau khi:
+    1. Đã chạy 01_add_siteid_to_users.sql và xác nhận KHÔNG còn user nào SiteId IS NULL
+       (câu SELECT cuối file 01 phải trả về 0 dòng - script này tự kiểm tra lại và dừng
+       nếu chưa đạt điều kiện).
+    2. Đã backup tbl_User_Site nếu muốn giữ lịch sử user từng thuộc Site nào trước đây.
+
+  Ghi chú convention: schema gốc (BaseSQL.sql) không dùng FOREIGN KEY constraint ở đâu cả,
+  chỉ dùng UNIQUE INDEX + app tự đảm bảo tính toàn vẹn - file này giữ đúng convention đó,
+  không thêm FK cho SiteId dù về mặt kỹ thuật có thể thêm.
+*/
+
+USE BaseRepo;
+GO
+
+IF EXISTS (SELECT 1 FROM tbl_Users WHERE SiteId IS NULL)
+BEGIN
+    RAISERROR('Còn user chưa có SiteId - chạy lại phần cuối 01_add_siteid_to_users.sql và gán tay cho hết trước khi chạy file này.', 16, 1);
+    RETURN;
+END
+GO
+
+ALTER TABLE [dbo].[tbl_Users] ALTER COLUMN [SiteId] VARCHAR(20) NOT NULL;
+GO
+
+-- tbl_Users.UserId trong BaseSQL.sql gốc có UNIQUE inline (constraint tên tự sinh, dạng
+-- UQ__tbl_Users__...) CỘNG THÊM 1 unique index đặt tên riêng IX_Users_UserId - cả hai
+-- cùng enforce unique toàn cục, cần bỏ CẢ HAI để đổi sang unique theo (SiteId, UserId).
+
+-- 2a) Bỏ constraint UNIQUE inline (tên tự sinh, tra theo sys.key_constraints)
+DECLARE @ConstraintName SYSNAME;
+SELECT @ConstraintName = kc.name
+FROM sys.key_constraints kc
+INNER JOIN sys.index_columns ic
+    ON ic.object_id = kc.parent_object_id AND ic.index_id = kc.unique_index_id
+INNER JOIN sys.columns c
+    ON c.object_id = ic.object_id AND c.column_id = ic.column_id
+WHERE kc.parent_object_id = OBJECT_ID('dbo.tbl_Users')
+  AND kc.[type] = 'UQ'
+  AND c.name = 'UserId'
+  AND ic.index_column_id = 1;                 -- chỉ lấy constraint đơn cột UserId
+
+IF @ConstraintName IS NOT NULL
+BEGIN
+    DECLARE @DropConstraintSql NVARCHAR(300) =
+        N'ALTER TABLE [dbo].[tbl_Users] DROP CONSTRAINT [' + @ConstraintName + N'];';
+    PRINT N'Dropping inline UNIQUE constraint: ' + @ConstraintName;
+    EXEC sp_executesql @DropConstraintSql;
+END
+GO
+
+-- 2b) Bỏ unique index đặt tên riêng
+IF EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_Users_UserId' AND object_id = OBJECT_ID('dbo.tbl_Users')
+)
+BEGIN
+    DROP INDEX [IX_Users_UserId] ON [dbo].[tbl_Users];
+END
+GO
+
+-- 2c) Tạo lại unique index theo (SiteId, UserId)
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_Users_SiteId_UserId' AND object_id = OBJECT_ID('dbo.tbl_Users')
+)
+BEGIN
+    CREATE UNIQUE INDEX [IX_Users_SiteId_UserId] ON [dbo].[tbl_Users]([SiteId], [UserId]);
+END
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_Users_SiteId' AND object_id = OBJECT_ID('dbo.tbl_Users')
+)
+BEGIN
+    CREATE INDEX [IX_Users_SiteId] ON [dbo].[tbl_Users]([SiteId]);
+END
+GO
+
+-- 3) Xoá bảng trung gian - quan hệ giờ là 1 User = 1 Site trực tiếp qua cột SiteId,
+--    không còn cần bảng N-N nữa.
+IF OBJECT_ID('dbo.tbl_User_Site', 'U') IS NOT NULL
+BEGIN
+    DROP TABLE [dbo].[tbl_User_Site];
+END
+GO
diff --git a/CommonLibs/BaseSQL/multi-tenant/03_create_site_module.sql b/CommonLibs/BaseSQL/multi-tenant/03_create_site_module.sql
new file mode 100644
index 0000000..459811c
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/03_create_site_module.sql
@@ -0,0 +1,96 @@
+/*
+  Tạo bảng tbl_Site_Module (entitlement + bật/tắt Module theo Site) và backfill từ quan hệ
+  Module.SiteId cũ, TRƯỚC KHI xoá cột SiteId khỏi tbl_Modules ở bước tiếp theo
+  (04_globalize_module_catalog.sql) - thứ tự bắt buộc, vì backfill cần đọc Module.SiteId
+  trong khi cột đó vẫn còn tồn tại.
+
+  Ý nghĩa dữ liệu sau backfill: mỗi Site tiếp tục có đúng những Module đang dùng hôm nay,
+  Status = 1 (bật) cho toàn bộ - không Site nào bị mất quyền truy cập Module đang chạy.
+  "Mặc định tắt" (không có dòng nào) chỉ áp dụng cho Module MỚI ra mắt sau thời điểm này.
+
+  Hai thao tác khác nhau trên bảng này (xem tài liệu thiết kế, mục 04+07):
+    - Tạo dòng (provisioning) = việc của đội vận hành khi Site mua thêm Module, KHÔNG
+      phải API Site Admin gọi được. Ở bản on-prem, việc này tương đương "không chạy seed
+      cho Module chưa mua". Ở bản thuê trọn bộ (nhiều Site chung 1 cụm hạ tầng), việc chỉ
+      tạo dòng khi đã mua chính là tương đương của "không deploy" trong bản on-prem.
+    - Bật/tắt Status trong các dòng đã tồn tại = quyền Site Admin bình thường.
+
+  Convention: không dùng FOREIGN KEY (khớp toàn bộ schema gốc BaseSQL.sql), chỉ dùng
+  UNIQUE INDEX.
+*/
+
+USE BaseRepo;
+GO
+
+IF OBJECT_ID('dbo.tbl_Site_Module', 'U') IS NULL
+BEGIN
+    CREATE TABLE [dbo].[tbl_Site_Module] (
+        [AutoId] BIGINT IDENTITY(1,1) PRIMARY KEY
+        ,[SiteId] VARCHAR(20) NOT NULL
+        ,[ModuleId] VARCHAR(50) NOT NULL
+        ,[CreatedDate] DATETIME2 NULL
+        ,[UpdatedDate] DATETIME2 NULL
+        ,[CreatedBy] NVARCHAR(20) NULL
+        ,[UpdatedBy] NVARCHAR(20) NULL
+        ,[Status] INT NOT NULL DEFAULT 1
+        ,[DeviceName] NVARCHAR(255) NULL
+        ,[DeviceId] NVARCHAR(255) NULL
+    );
+END
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_tbl_Site_Module_SiteId_ModuleId' AND object_id = OBJECT_ID('dbo.tbl_Site_Module')
+)
+BEGIN
+    CREATE UNIQUE INDEX [IX_tbl_Site_Module_SiteId_ModuleId]
+        ON [dbo].[tbl_Site_Module]([SiteId], [ModuleId]);
+END
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_tbl_Site_Module_SiteId' AND object_id = OBJECT_ID('dbo.tbl_Site_Module')
+)
+BEGIN
+    CREATE INDEX [IX_tbl_Site_Module_SiteId] ON [dbo].[tbl_Site_Module]([SiteId]);
+END
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_tbl_Site_Module_ModuleId' AND object_id = OBJECT_ID('dbo.tbl_Site_Module')
+)
+BEGIN
+    CREATE INDEX [IX_tbl_Site_Module_ModuleId] ON [dbo].[tbl_Site_Module]([ModuleId]);
+END
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_tbl_Site_Module_Status_CreatedDate_UpdatedDate' AND object_id = OBJECT_ID('dbo.tbl_Site_Module')
+)
+BEGIN
+    CREATE INDEX [IX_tbl_Site_Module_Status_CreatedDate_UpdatedDate]
+        ON [dbo].[tbl_Site_Module]([Status], [CreatedDate] DESC, [UpdatedDate] DESC);
+END
+GO
+
+-- Backfill: Module hiện đang gắn SiteId nào -> bật sẵn (Status = 1) cho đúng Site đó,
+-- để không Site nào mất quyền dùng Module đang chạy khi cột SiteId bị xoá ở bước sau.
+INSERT INTO [dbo].[tbl_Site_Module] ([SiteId], [ModuleId], [Status], [CreatedDate])
+SELECT m.SiteId, m.ModuleId, 1, SYSUTCDATETIME()
+FROM tbl_Modules m
+WHERE NOT EXISTS (
+    SELECT 1 FROM tbl_Site_Module sm
+    WHERE sm.SiteId = m.SiteId AND sm.ModuleId = m.ModuleId
+);
+GO
+
+-- Đối chiếu: số dòng backfill nên bằng đúng số dòng tbl_Modules hiện có (mỗi Module chỉ
+-- gắn 1 SiteId trong schema cũ, nên 1-1 với tbl_Site_Module sau backfill).
+SELECT
+    (SELECT COUNT(*) FROM tbl_Modules) AS TotalModulesBeforeGlobalize
+    ,(SELECT COUNT(*) FROM tbl_Site_Module) AS TotalSiteModuleRows;
+GO
diff --git a/CommonLibs/BaseSQL/multi-tenant/04_globalize_module_catalog.sql b/CommonLibs/BaseSQL/multi-tenant/04_globalize_module_catalog.sql
new file mode 100644
index 0000000..ec13ec4
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/04_globalize_module_catalog.sql
@@ -0,0 +1,73 @@
+/*
+  Bỏ SiteId khỏi tbl_Modules - chuyển thành danh mục dùng chung toàn hệ thống thay vì lặp
+  lại theo từng Site (xem tài liệu thiết kế, mục 04). tbl_Screens và tbl_Functions trong
+  schema gốc (BaseSQL.sql) KHÔNG có cột SiteId trực tiếp (chỉ có ModuleId/ScreenId) - đã
+  toàn cục sẵn từ trước một cách gián tiếp qua chuỗi Module -> Screen -> Function, nên
+  không cần đổi gì ở 2 bảng đó. Hai khối IF ở cuối file chỉ là phòng hờ, sẽ không làm gì
+  cả trên schema gốc - chỉ có tác dụng nếu DB thực tế của bạn đã tự thêm SiteId khác với
+  schema gửi kèm.
+
+  ⚠️ Bắt buộc đã chạy xong 03_create_site_module.sql TRƯỚC file này - backfill ở đó cần
+  đọc tbl_Modules.SiteId trong khi cột còn tồn tại. Script này tự kiểm tra và dừng nếu
+  chưa đạt điều kiện.
+
+  ⚠️ Trước khi chạy: kiểm tra không có 2 Site nào đang định nghĩa cùng ý nghĩa nghiệp vụ
+  nhưng khác ModuleId (VD Site A có Module "QuanLyNguoiDung", Site B có Module "UserMgmt"
+  cho cùng 1 chức năng) - nếu có, phải gộp lại thủ công thành 1 bản ghi trước khi drop
+  cột, nếu không sẽ có nhiều dòng trùng nghĩa nhưng khác mã tồn tại song song sau khi gộp.
+  Đây là việc cần review dữ liệu bằng mắt, không có câu SQL nào tự phát hiện "cùng ý
+  nghĩa nghiệp vụ" một cách an toàn.
+*/
+
+USE BaseRepo;
+GO
+
+IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'tbl_Site_Module')
+   OR (SELECT COUNT(*) FROM tbl_Site_Module) < (SELECT COUNT(*) FROM tbl_Modules)
+BEGIN
+    RAISERROR('Chưa chạy xong 03_create_site_module.sql (thiếu bảng hoặc backfill chưa đủ) - chạy file đó trước.', 16, 1);
+    RETURN;
+END
+GO
+
+-- tbl_Modules
+IF EXISTS (
+    SELECT 1 FROM sys.indexes WHERE name = 'IX_Modules_SiteId' AND object_id = OBJECT_ID('dbo.tbl_Modules')
+)
+BEGIN
+    DROP INDEX [IX_Modules_SiteId] ON [dbo].[tbl_Modules];
+END
+GO
+
+IF EXISTS (
+    SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.tbl_Modules') AND name = 'SiteId'
+)
+BEGIN
+    ALTER TABLE [dbo].[tbl_Modules] DROP COLUMN [SiteId];
+END
+GO
+
+-- tbl_Screens - phòng hờ, no-op trên schema gốc (không có cột SiteId để xoá)
+IF EXISTS (
+    SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.tbl_Screens') AND name = 'SiteId'
+)
+BEGIN
+    IF EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_Screens_SiteId' AND object_id = OBJECT_ID('dbo.tbl_Screens'))
+        DROP INDEX [IX_Screens_SiteId] ON [dbo].[tbl_Screens];
+    ALTER TABLE [dbo].[tbl_Screens] DROP COLUMN [SiteId];
+END
+GO
+
+-- tbl_Functions - phòng hờ, no-op trên schema gốc (không có cột SiteId để xoá)
+IF EXISTS (
+    SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.tbl_Functions') AND name = 'SiteId'
+)
+BEGIN
+    IF EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_Functions_SiteId' AND object_id = OBJECT_ID('dbo.tbl_Functions'))
+        DROP INDEX [IX_Functions_SiteId] ON [dbo].[tbl_Functions];
+    ALTER TABLE [dbo].[tbl_Functions] DROP COLUMN [SiteId];
+END
+GO
+
+-- ModuleId/ScreenId/FunctionId giữ nguyên UNIQUE toàn cục như hiện tại - không đổi gì,
+-- vì giờ chúng đúng nghĩa là danh mục dùng chung, không còn lặp lại theo Site nữa.
diff --git a/CommonLibs/BaseSQL/multi-tenant/05_add_siteid_to_role_tables.sql b/CommonLibs/BaseSQL/multi-tenant/05_add_siteid_to_role_tables.sql
new file mode 100644
index 0000000..d1ee4aa
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/05_add_siteid_to_role_tables.sql
@@ -0,0 +1,99 @@
+/*
+  Thêm SiteId (denormalize từ tbl_Roles) vào tbl_Role_Function và tbl_User_Role - để lọc
+  theo Site không cần join qua tbl_Roles, và để bật Row-Level Security ở bước sau
+  (06_enable_row_level_security.sql). tbl_Roles đã có sẵn SiteId từ trước, không đổi gì
+  ở bảng đó.
+
+  Ghi chú kiểu dữ liệu: tbl_Roles.SiteId trong BaseSQL.sql gốc khai báo VARCHAR(50) (khác
+  với tbl_Site.SiteId là VARCHAR(20) - lệch kiểu có sẵn từ trước trong schema gốc, không
+  phải lỗi phát sinh ở migration này). Hai cột mới dưới đây dùng VARCHAR(50) cho khớp
+  đúng kiểu nguồn copy (tbl_Roles.SiteId) - cân nhắc chuẩn hoá cả 2 về VARCHAR(20) trong
+  một đợt dọn dẹp riêng nếu muốn, ngoài phạm vi file này.
+
+  Convention: không dùng FOREIGN KEY (khớp schema gốc), chỉ dùng INDEX.
+*/
+
+USE BaseRepo;
+GO
+
+-- ===== tbl_Role_Function =====
+IF NOT EXISTS (
+    SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.tbl_Role_Function') AND name = 'SiteId'
+)
+BEGIN
+    ALTER TABLE [dbo].[tbl_Role_Function] ADD [SiteId] VARCHAR(50) NULL;
+END
+GO
+
+UPDATE rf
+SET rf.SiteId = r.SiteId
+FROM tbl_Role_Function rf
+INNER JOIN tbl_Roles r ON r.RoleId = rf.RoleId
+WHERE rf.SiteId IS NULL;
+GO
+
+IF EXISTS (SELECT 1 FROM tbl_Role_Function WHERE SiteId IS NULL)
+BEGIN
+    RAISERROR('tbl_Role_Function còn dòng không backfill được SiteId - có RoleId mồ côi (không còn tồn tại trong tbl_Roles), rà lại trước khi ép NOT NULL.', 16, 1);
+    RETURN;
+END
+GO
+
+ALTER TABLE [dbo].[tbl_Role_Function] ALTER COLUMN [SiteId] VARCHAR(50) NOT NULL;
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes WHERE name = 'IX_tbl_Role_Function_SiteId' AND object_id = OBJECT_ID('dbo.tbl_Role_Function')
+)
+BEGIN
+    CREATE INDEX [IX_tbl_Role_Function_SiteId] ON [dbo].[tbl_Role_Function]([SiteId]);
+END
+GO
+
+-- ===== tbl_User_Role =====
+IF NOT EXISTS (
+    SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.tbl_User_Role') AND name = 'SiteId'
+)
+BEGIN
+    ALTER TABLE [dbo].[tbl_User_Role] ADD [SiteId] VARCHAR(50) NULL;
+END
+GO
+
+UPDATE ur
+SET ur.SiteId = r.SiteId
+FROM tbl_User_Role ur
+INNER JOIN tbl_Roles r ON r.RoleId = ur.RoleId
+WHERE ur.SiteId IS NULL;
+GO
+
+IF EXISTS (SELECT 1 FROM tbl_User_Role WHERE SiteId IS NULL)
+BEGIN
+    RAISERROR('tbl_User_Role còn dòng không backfill được SiteId - có RoleId mồ côi (không còn tồn tại trong tbl_Roles), rà lại trước khi ép NOT NULL.', 16, 1);
+    RETURN;
+END
+GO
+
+ALTER TABLE [dbo].[tbl_User_Role] ALTER COLUMN [SiteId] VARCHAR(50) NOT NULL;
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes WHERE name = 'IX_tbl_User_Role_SiteId' AND object_id = OBJECT_ID('dbo.tbl_User_Role')
+)
+BEGIN
+    CREATE INDEX [IX_tbl_User_Role_SiteId] ON [dbo].[tbl_User_Role]([SiteId]);
+END
+GO
+
+-- ===== Sanity check (chỉ đọc, không tự sửa) =====
+-- Ràng buộc nghiệp vụ "Role.SiteId phải khớp User.SiteId" nay áp dụng ở tầng ứng dụng khi
+-- CreateUserRole (thay cho điều kiện "phải có UserSite active" đã bỏ ở bước 02). Câu dưới
+-- đây rà dữ liệu CŨ có sẵn hàng nào vi phạm hay không - dùng khoá (UserId, SiteId) đã
+-- unique từ bước 02 để so khớp chính xác, KHÔNG join chỉ theo UserId vì UserId không còn
+-- duy nhất toàn cục.
+SELECT ur.AutoId, ur.UserId, ur.RoleId, ur.SiteId AS RoleSiteId
+FROM tbl_User_Role ur
+WHERE NOT EXISTS (
+    SELECT 1 FROM tbl_Users u
+    WHERE u.UserId = ur.UserId AND u.SiteId = ur.SiteId
+);
+GO
diff --git a/CommonLibs/BaseSQL/multi-tenant/06_enable_row_level_security.sql b/CommonLibs/BaseSQL/multi-tenant/06_enable_row_level_security.sql
new file mode 100644
index 0000000..346f2ca
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/06_enable_row_level_security.sql
@@ -0,0 +1,61 @@
+/*
+  Row-Level Security theo SiteId - lưới an toàn thứ hai (xem tài liệu thiết kế, mục 04).
+
+  TUỲ CHỌN - chỉ bật sau khi:
+    1. Toàn bộ code C# (AuditContext, BaseRepository, mọi nơi mở connection...) đã set
+       đúng SESSION_CONTEXT('SiteId') TRƯỚC khi query - bật RLS quá sớm sẽ chặn nhầm
+       chính request hợp lệ nếu code chưa kịp set context.
+    2. Đã test kỹ ở môi trường staging - RLS áp dụng cho MỌI câu query lên 4 bảng bên
+       dưới, kể cả khi bạn tự debug bằng SSMS (trừ khi đang là thành viên db_owner, xem
+       predicate function bên dưới).
+
+  Ở bản deploy on-prem (chỉ 1 Site), RLS không bắt buộc nhưng bật sẵn để hành vi nhất
+  quán giữa 2 hình thức bán hàng (thuê trọn bộ / on-prem).
+*/
+
+USE BaseRepo;
+GO
+
+IF OBJECT_ID('dbo.fn_SitePredicate', 'IF') IS NOT NULL
+BEGIN
+    -- Không thể DROP FUNCTION trong khi còn gắn với security policy đang bật - tắt/drop
+    -- policy trước (khối bên dưới), rồi mới tới đây được. Giữ khối này để script chạy lại
+    -- được an toàn (idempotent) nếu cần chỉnh sửa predicate sau này.
+    DROP FUNCTION [dbo].[fn_SitePredicate];
+END
+GO
+
+CREATE FUNCTION [dbo].[fn_SitePredicate](@SiteId VARCHAR(20))
+RETURNS TABLE
+WITH SCHEMABINDING
+AS
+RETURN SELECT 1 AS fn_result
+    WHERE @SiteId = CAST(SESSION_CONTEXT(N'SiteId') AS VARCHAR(20))
+       OR IS_MEMBER('db_owner') = 1;   -- cho phép DBA/tài khoản migration tự bypass khi cần
+GO
+
+IF EXISTS (SELECT 1 FROM sys.security_policies WHERE name = 'SiteIsolationPolicy')
+BEGIN
+    ALTER SECURITY POLICY [SiteIsolationPolicy] WITH (STATE = OFF);
+    DROP SECURITY POLICY [SiteIsolationPolicy];
+END
+GO
+
+CREATE SECURITY POLICY [SiteIsolationPolicy]
+    ADD FILTER PREDICATE [dbo].[fn_SitePredicate]([SiteId]) ON [dbo].[tbl_Users]
+    ,ADD FILTER PREDICATE [dbo].[fn_SitePredicate]([SiteId]) ON [dbo].[tbl_Roles]
+    ,ADD FILTER PREDICATE [dbo].[fn_SitePredicate]([SiteId]) ON [dbo].[tbl_Role_Function]
+    ,ADD FILTER PREDICATE [dbo].[fn_SitePredicate]([SiteId]) ON [dbo].[tbl_User_Role]
+    WITH (STATE = ON);
+GO
+
+-- Nhắc khi wire vào code (CommonLibs/BaseDbContext/BaseDbContext.cs hoặc nơi mở
+-- connection): mỗi connection mới phải chạy trước mọi câu SELECT/UPDATE khác:
+--   EXEC sp_set_session_context @key = N'SiteId', @value = @siteId, @read_only = 1;
+-- Chưa set thì SESSION_CONTEXT('SiteId') trả về NULL -> predicate luôn false (trừ
+-- db_owner) -> mọi query lên 4 bảng trên trả về rỗng, không phải lỗi, dễ nhầm là bug.
+
+-- Muốn tắt tạm để debug mà không xoá hẳn policy:
+--   ALTER SECURITY POLICY [SiteIsolationPolicy] WITH (STATE = OFF);
+-- Bật lại:
+--   ALTER SECURITY POLICY [SiteIsolationPolicy] WITH (STATE = ON);
diff --git a/CommonLibs/BaseSQL/multi-tenant/07_backfill_admin_role_functions.sql b/CommonLibs/BaseSQL/multi-tenant/07_backfill_admin_role_functions.sql
new file mode 100644
index 0000000..5b14504
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/07_backfill_admin_role_functions.sql
@@ -0,0 +1,67 @@
+/*
+  Backfill Function cho mọi Role tên "Admin" - BẮT BUỘC chạy cùng đợt deploy code đã bỏ cơ chế
+  bypass "Admin toàn hệ thống" trong CommonLibs/Middlewares/AuthorizationMiddleware.cs.
+
+  Bối cảnh: trước đây AuthorizationMiddleware cho phép bất kỳ user nào có Role tên "Admin" (so khớp
+  literal, không phân biệt hoa/thường) bỏ qua mọi kiểm tra [RequireFunction(...)], bất kể Role "Admin"
+  đó do Site nào cấp. Sau khi mỗi Site tự có Role "Admin" riêng (multi-tenant), hành vi này vô tình cho
+  phép Admin của Site A bỏ qua kiểm tra quyền trên tài nguyên của Site B - đã BỎ bypass này trong code
+  (xem AuthorizationMiddleware.cs, BaseController.IsSiteAdmin, và đã xoá "AdminPolicy" ở 3 Program.cs).
+
+  HỆ QUẢ: ngay khi bỏ bypass, Role "Admin" của MỌI Site sẽ mất hết quyền thao tác đã hoạt động trước
+  đó, TRỪ KHI tbl_Role_Function đã có sẵn đủ dòng cấp quyền tường minh. Script này backfill đúng 1 lần,
+  cấp cho mọi Role tên "Admin" toàn bộ Function đang active (Status = 1) hiện có trong hệ thống - tương
+  đương với đúng quyền hạn mà bypass cũ từng ngầm cấp - để không Site nào bị khoá quyền đột ngột ngay
+  khi deploy đợt fix này.
+
+  LƯU Ý: đây là backfill "grandfather" 1 lần cho đúng ngày cutover, KHÔNG phải khẳng định "Role Admin
+  nên luôn có mọi Function mãi mãi". Sau khi deploy ổn định, cân nhắc rà lại và thu hẹp quyền của từng
+  Role "Admin" qua chính API AssignRolePermissions (Site.Application/Features/Permission) nếu muốn quản
+  trị theo nguyên tắc least-privilege chặt hơn - script này không tự làm việc đó.
+
+  Thứ tự chạy: SAU 05_add_siteid_to_role_tables.sql (cần cột tbl_Role_Function.SiteId đã tồn tại và
+  NOT NULL để insert đúng). Không phụ thuộc 06 (RLS) - chạy được dù RLS đang bật hay tắt.
+
+  Convention: không dùng FOREIGN KEY (khớp schema gốc), chỉ dùng INDEX/UNIQUE INDEX sẵn có.
+*/
+
+USE BaseRepo;
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.tbl_Role_Function') AND name = 'SiteId'
+)
+BEGIN
+    RAISERROR('tbl_Role_Function chưa có cột SiteId - chạy 05_add_siteid_to_role_tables.sql trước.', 16, 1);
+    RETURN;
+END
+GO
+
+-- Cấp toàn bộ Function đang active cho mọi Role tên "Admin" (mọi Site), bỏ qua dòng đã tồn tại sẵn.
+INSERT INTO [dbo].[tbl_Role_Function] ([RoleId], [FunctionId], [SiteId], [Status], [CreatedDate])
+SELECT r.RoleId, f.FunctionId, r.SiteId, 1, SYSUTCDATETIME()
+FROM tbl_Roles r
+CROSS JOIN tbl_Functions f
+WHERE r.RoleName = N'Admin'
+  AND r.Status = 1
+  AND f.Status = 1
+  AND NOT EXISTS (
+      SELECT 1 FROM tbl_Role_Function rf
+      WHERE rf.RoleId = r.RoleId AND rf.FunctionId = f.FunctionId
+  );
+GO
+
+-- Đối chiếu: mỗi Role "Admin" đang active nên có đúng bằng tổng số Function đang active. Dòng nào lệch
+-- (ShortBy > 0) nghĩa là còn thiếu Function - kiểm tra lại trước khi coi đợt backfill là hoàn tất.
+SELECT
+    r.RoleId
+    ,r.SiteId
+    ,r.RoleName
+    ,(SELECT COUNT(*) FROM tbl_Role_Function rf WHERE rf.RoleId = r.RoleId AND rf.Status = 1) AS GrantedFunctionCount
+    ,(SELECT COUNT(*) FROM tbl_Functions WHERE Status = 1) AS TotalActiveFunctionCount
+    ,(SELECT COUNT(*) FROM tbl_Functions WHERE Status = 1)
+        - (SELECT COUNT(*) FROM tbl_Role_Function rf WHERE rf.RoleId = r.RoleId AND rf.Status = 1) AS ShortBy
+FROM tbl_Roles r
+WHERE r.RoleName = N'Admin' AND r.Status = 1
+ORDER BY r.SiteId;
+GO
diff --git a/CommonLibs/BaseSQL/multi-tenant/08_fix_roleid_unique_scope.sql b/CommonLibs/BaseSQL/multi-tenant/08_fix_roleid_unique_scope.sql
new file mode 100644
index 0000000..d6194ff
--- /dev/null
+++ b/CommonLibs/BaseSQL/multi-tenant/08_fix_roleid_unique_scope.sql
@@ -0,0 +1,83 @@
+/*
+  Fix bị bỏ sót trong đợt migration multi-tenant trước: tbl_Roles.RoleId vẫn đang là UNIQUE
+  INDEX toàn cục (IX_Roles_RoleId, từ schema gốc BaseSQL.sql) - CHƯA từng được đổi sang
+  unique theo (SiteId, RoleId) ở bất kỳ script 01-07 nào. 05_add_siteid_to_role_tables.sql
+  chỉ backfill cột SiteId cho tbl_Role_Function/tbl_User_Role, còn ghi rõ "tbl_Roles đã có
+  sẵn SiteId từ trước, không đổi gì ở bảng đó" - nhưng lại quên luôn cả việc đổi UNIQUE INDEX
+  của RoleId, y hệt lỗi mà 02_finalize_users_siteid.sql đã xử lý đúng cho UserId.
+
+  Hệ quả nếu KHÔNG chạy file này: 2 Site khác nhau KHÔNG THỂ có Role trùng RoleId (VD cả
+  2 Site cùng đặt RoleId 'ADMIN') - INSERT dòng thứ 2 sẽ bị SQL Server từ chối với lỗi vi
+  phạm UNIQUE INDEX. Đây chính là kịch bản "RoleId trùng tên nhau giữa 2 Site" mà tài liệu
+  thiết kế và README (mục "Không nằm trong các script này") yêu cầu phải test được - nói
+  cách khác, trước khi chạy file này, kịch bản đó không thể xảy ra dù ở tầng ứng dụng đã
+  sẵn sàng xử lý đúng (xem các fix trong UserRoleRepository/PermissionRepository/... cùng
+  đợt), vì bị chặn ngay ở tầng DB.
+
+  Cùng convention 02_finalize_users_siteid.sql: bỏ UNIQUE INDEX/CONSTRAINT đơn cột RoleId,
+  tạo lại UNIQUE INDEX theo (SiteId, RoleId). Không dùng FOREIGN KEY (khớp toàn bộ schema
+  gốc).
+
+  ⚠️ Trước khi chạy: đảm bảo không có 2 dòng tbl_Roles nào hiện tại trùng (SiteId, RoleId)
+  (không thể xảy ra vì RoleId đang unique toàn cục nên chắc chắn không trùng - bước kiểm
+  tra dưới đây chỉ để phòng hờ nếu dữ liệu đã bị chỉnh sửa thủ công ngoài quy trình).
+*/
+
+USE BaseRepo;
+GO
+
+IF EXISTS (
+    SELECT SiteId, RoleId FROM tbl_Roles
+    GROUP BY SiteId, RoleId
+    HAVING COUNT(*) > 1
+)
+BEGIN
+    RAISERROR('tbl_Roles đang có dòng trùng (SiteId, RoleId) - rà lại dữ liệu trước khi đổi unique index.', 16, 1);
+    RETURN;
+END
+GO
+
+-- 1) Bỏ constraint UNIQUE inline (tên tự sinh, tra theo sys.key_constraints) nếu có
+DECLARE @ConstraintName SYSNAME;
+SELECT @ConstraintName = kc.name
+FROM sys.key_constraints kc
+INNER JOIN sys.index_columns ic
+    ON ic.object_id = kc.parent_object_id AND ic.index_id = kc.unique_index_id
+INNER JOIN sys.columns c
+    ON c.object_id = ic.object_id AND c.column_id = ic.column_id
+WHERE kc.parent_object_id = OBJECT_ID('dbo.tbl_Roles')
+  AND kc.[type] = 'UQ'
+  AND c.name = 'RoleId'
+  AND ic.index_column_id = 1;
+
+IF @ConstraintName IS NOT NULL
+BEGIN
+    DECLARE @DropConstraintSql NVARCHAR(300) =
+        N'ALTER TABLE [dbo].[tbl_Roles] DROP CONSTRAINT [' + @ConstraintName + N'];';
+    PRINT N'Dropping inline UNIQUE constraint: ' + @ConstraintName;
+    EXEC sp_executesql @DropConstraintSql;
+END
+GO
+
+-- 2) Bỏ unique index đặt tên riêng (IX_Roles_RoleId, từ BaseSQL.sql)
+IF EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_Roles_RoleId' AND object_id = OBJECT_ID('dbo.tbl_Roles')
+)
+BEGIN
+    DROP INDEX [IX_Roles_RoleId] ON [dbo].[tbl_Roles];
+END
+GO
+
+-- 3) Tạo lại UNIQUE INDEX theo (SiteId, RoleId) - mỗi Site tự quản RoleId độc lập
+IF NOT EXISTS (
+    SELECT 1 FROM sys.indexes
+    WHERE name = 'IX_Roles_SiteId_RoleId' AND object_id = OBJECT_ID('dbo.tbl_Roles')
+)
+BEGIN
+    CREATE UNIQUE INDEX [IX_Roles_SiteId_RoleId] ON [dbo].[tbl_Roles]([SiteId], [RoleId]);
+END
+GO
+
+-- IX_Roles_ScreenId (tên đặt nhầm từ BaseSQL.sql gốc, thực chất index trên cột SiteId) đã
+-- tồn tại sẵn từ trước, không cần tạo lại - vẫn hữu ích cho lookup theo SiteId.
