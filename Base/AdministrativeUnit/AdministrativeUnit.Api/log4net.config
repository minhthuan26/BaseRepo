<?xml version="1.0" encoding="utf-8" ?>
<log4net>

	<appender name="ConsoleAppender" type="log4net.Appender.ManagedColoredConsoleAppender">
		<mapping>
			<level value="WARN" />
			<foreColor value="Yellow" />
		</mapping>
		<mapping>
			<level value="INFO" />
			<foreColor value="Green" />
		</mapping>
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{HH:mm:ss} %-5level] [AdministrativeUnit-Service] [%property{CorrelationId}] %message%newline%exception" />
		</layout>
	</appender>

	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">

		<file type="log4net.Util.PatternString" value="%property{LogRootPath}/Logs/administrativeunit_log.json" />

		<appendToFile value="true" />
		<rollingStyle value="Date" />

		<datePattern value="-yyyyMMdd" />

		<preserveLogFileNameExtension value="true" />

		<staticLogFileName value="false" />

		<maxSizeRollBackups value="30" />

		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%message%newline" />
		</layout>

	</appender>

	<logger name="ElasticSearchLogger" additivity="false">
		<level value="INFO" />
		<appender-ref ref="RollingFileAppender" />
	</logger>

	<root>
		<level value="INFO" />
		<appender-ref ref="ConsoleAppender" />
	</root>

</log4net>
