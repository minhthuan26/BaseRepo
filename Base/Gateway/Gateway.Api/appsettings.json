{
  // Cấu hình chung cho ứng dụng
  "AllowedHosts": "*",
  // Thông tin về ứng dụng, có thể được sử dụng trong log để phân biệt giữa các service
  "Application": {
    "ApplicationId": "Gateway",
    "ApplicationName": "Base Repo Gateway",
    "Version": "1.0.0",
    "AccessKey": "BaseRepo__JWT__AccessKey",
    "RefreshKey": "BaseRepo__JWT__RefreshKey",
    "Audience": "BaseRepo__JWT__Audience",
    "Issuer": "BaseRepo__JWT__Issuer",
    "PrivateKey": "BaseRepo__PrivateKey",
    "PublicKey": "BaseRepo__PublicKey",

    // Cấu hình kết nối đến Redis
    "RedisConnectionString": "localhost:8012,abortConnect=false,connectTimeout=5000",
    // Cấu hình kết nối đến RabbitMQ, phục vụ cho việc gửi và nhận message giữa các service
    "RabbitMqConnectionString": "amqp://guest:guest@localhost:8013/"
  },
  // Cấu hình kết nối đến SQL Server
  "ConnectionInfo": {
    "Host": "localhost,1433",
    "Database": "BaseRepo",
    "UserName": "GtaKIbrsY4Z7ebPCkH4Dkw==",
    "Password": "JbimeBVIWAdCFZUVs7lhgQ=="
  },
  "WindowsServiceDependencies": [
    "_Redis_8012",
    "RabbitMQ"
  ],
  // Cấu hình có lưu body không
  "Logging": {
    "Provider": "Serilog",
    "LogRequestBody": true,
    "LogResponseBody": true,
    "LogSuccessResponse": true,
    "LogFailedResponse": true,
    "MaxBodyLength": 5000
  },
  // Cấu hình YARP để định tuyến các request đến các service con
  "ReverseProxy": {
    "Routes": {
      // [2026-09-01] URL scheme đổi sang tiền tố theo TÊN SERVICE (không phải theo domain-group
      // Base/SportsBooking - 1 domain-group có thể gồm nhiều service khác nhau, VD Base gồm cả
      // Site lẫn AdministrativeUnit, dùng domain-group làm tiền tố sẽ không đủ để YARP phân biệt
      // đích đến). Mỗi cluster giờ chỉ còn 1 route (site) hoặc 2 route đọc/ghi (administrativeunit,
      // booking) áp dụng cho MỌI entity hiện có lẫn entity thêm mới sau này - không cần sửa file
      // này khi thêm Controller mới miễn nó theo đúng kiểu phân quyền sẵn có của service đó.
      // Cơ chế: "Transforms/PathPattern" bóc tiền tố service ra trước khi forward xuống service con,
      // nên KHÔNG cần đổi route attribute của bất kỳ Controller nào (VD client gọi
      // "/api/site/role" -> Gateway rewrite thành "/api/role" -> RoleController nhận y hệt như cũ).
      // BREAKING CHANGE: mọi URL cũ không còn tiền tố (/api/ward, /api/field...) đổi thành có tiền
      // tố (/api/administrativeunit/ward, /api/booking/field...) - FE phải cập nhật base path theo
      // từng service. CHƯA TEST (môi trường hiện tại không đủ SQL Server/Redis để chạy thật).
      "site-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Order": 100,
        "Match": { "Path": "/api/site/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      // tbl_Site_Module (SiteModuleController) - CHỦ Ý chỉ mở đúng 2 route "my" và "toggle" ra Gateway công khai,
      // KHÔNG dùng {**catch-all} như "site-route" ở trên. 2 action còn lại của controller này (provision, xem theo
      // 1 SiteId bất kỳ) là API nội bộ cho đội vận hành - cố tình không có route YARP nên không gọi được qua
      // Gateway, chỉ gọi trực tiếp vào cổng nội bộ của Site service. Xem SiteModuleController.cs. Không có
      // "Order" tường minh (mặc định match trước "site-route" vì path cụ thể hơn) nhưng PHẢI test lại thật kỹ
      // sau khi thêm "site-route" catch-all - nếu route catch-all vô tình match trước, 2 action nội bộ trên sẽ
      // vô tình lộ ra Gateway (regression bảo mật), phải chặn ngay nếu test thấy sai.
      "site-module-my-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/site/site-module/my", "Methods": [ "GET" ] },
        "Transforms": [ { "PathPattern": "/api/site-module/my" } ]
      },
      "site-module-toggle-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/site/site-module/toggle", "Methods": [ "PUT" ] },
        "Transforms": [ { "PathPattern": "/api/site-module/toggle" } ]
      },
      "site-swagger-route": {
        "ClusterId": "site-cluster",
        "Match": { "Path": "/site-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      // Toàn bộ entity của AdministrativeUnit (Province/Ward, và entity thêm mới sau này) đều theo
      // đúng 1 pattern: API đọc (GET) Anonymous để FE lấy dropdown địa chỉ mà không cần token, API
      // ghi (POST/PUT/DELETE) cần UserOrAdminPolicy. Vì AuthorizationPolicy của YARP chặn ngay tại
      // Gateway trước khi forward xuống service, vẫn phải tách 2 route theo Methods như cũ - nhưng
      // giờ dùng chung cho MỌI entity của service này, không phải khai riêng từng entity nữa.
      "administrativeunit-read-route": {
        "ClusterId": "administrativeunit-cluster",
        "Match": { "Path": "/api/administrativeunit/{**catch-all}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "administrativeunit-write-route": {
        "ClusterId": "administrativeunit-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/administrativeunit/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "administrativeunit-swagger-route": {
        "ClusterId": "administrativeunit-cluster",
        "Match": { "Path": "/administrativeunit-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      // Cùng pattern đọc-công-khai/ghi-cần-auth như administrativeunit-cluster ở trên, áp dụng cho
      // mọi entity của Booking (FieldType/Field/PricingRule hiện có, và Customer/Booking/RecurringGroup
      // sắp thêm ở phần còn lại của Phase 1 - KHÔNG cần sửa route khi thêm các entity đó, miễn theo
      // đúng pattern đọc-công-khai/ghi-cần-auth này).
      "booking-read-route": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/api/booking/{**catch-all}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "booking-write-route": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/booking/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "booking-swagger-route": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/booking-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "site-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:8001/" } }
      },
      "administrativeunit-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:8002/" } }
      },
      "booking-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:8003/" } }
      }
    }
  },

  // Cấu hình danh sách các tài liệu hiển thị trên Gateway
  "MicroservicesSwagger": {
    "Docs": [
      {
        "Name": "site-service",
        "Title": "Site Management API",
        "Url": "/site-swagger/v1/swagger.json"
      },
      {
        "Name": "auth-service",
        "Title": "Authentication API",
        "Url": "/auth-swagger/v1/swagger.json"
      },
      {
        "Name": "administrativeunit-service",
        "Title": "Administrative Unit API",
        "Url": "/administrativeunit-swagger/v1/swagger.json"
      },
      {
        "Name": "booking-service",
        "Title": "Booking API",
        "Url": "/booking-swagger/v1/swagger.json"
      }
    ]
  }
}
