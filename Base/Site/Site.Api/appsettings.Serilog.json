{
  // Cấu hình Serilog để ghi log vào file
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning", // Giảm bớt log hệ thống của Microsoft
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      // 1. Ghi log ra Console để dev dễ nhìn khi chạy local
      {
        "Name": "Console",
        "Args": {
          // Định dạng màu sắc và cấu trúc hiển thị trên Console (Dễ đọc hơn JSON thô)
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console" // Thêm màu sắc cho chữ
        }
      },
      // 2. Ghi log ra File dạng JSON
      {
        "Name": "File",
        "Args": {
          // Nếu muốn ghi log dưới dạng JSON, hãy bỏ comment dòng formatter và comment dòng outputTemplate
          //"formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact", // Ghi log dưới dạng JSON để dễ dàng phân tích và tìm kiếm
          "path": "Logs/site_log-.json", // Đường dẫn thư mục Logs/log-20260519.txt
          "rollingInterval": "Day", // Tự động tạo file mới mỗi ngày
          "retainedFileCountLimit": 30, // Giữ lại log của tối đa 30 ngày gần nhất
          // dùng khi không áp dụng elasticsearch
          //"outputTemplate": "[{Timestamp:dd-MM-yyyy HH:mm:ss} {Level:u3}] [{Application}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {@t: UtcDateTime(@t), LocalTime: @p['LocalTime'], @l: @l, Application: @p['Application'], CorrelationId: @p['CorrelationId'], Message: @m, Exception: @x, Properties: Rest()} }\n"
          }
        }
      }
    ],
    // Thêm thông tin ứng dụng vào log để dễ dàng phân biệt giữa các service
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "Site-Service" // Thay đổi tên tương ứng với từng Project
    }
  }
}
