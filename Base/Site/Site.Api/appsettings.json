{
  // Cấu hình chung cho ứng dụng
  "AllowedHosts": "*",
  // Thông tin về ứng dụng, có thể được sử dụng trong log để phân biệt giữa các service
  "Application": {
    "ApplicationId": "Site",
    "ApplicationName": "Base Repo Site",
    "Version": "1.0.0",
    "AccessKey": "BaseRepo__JWT__AccessKey",
    "RefreshKey": "BaseRepo__JWT__RefreshKey",
    "Audience": "BaseRepo__JWT__Audience",
    "Issuer": "BaseRepo__JWT__Issuer",
    "PrivateKey": "BaseRepo__PrivateKey",
    "PublicKey": "BaseRepo__PublicKey",

    // Cấu hình kết nối đến Redis
    "RedisConnectionString": "localhost:8012,abortConnect=false,connectTimeout=5000",
    // Cấu hình kết nối đến RabbitMQ, phục vụ cho việc gửi và nhận message giữa các service
    "RabbitMqConnectionString": "amqp://guest:guest@localhost:8013/"
  },
  // Cấu hình kết nối đến SQL Server
  "ConnectionInfo": {
    "Host": "localhost,1433",
    "Database": "BaseRepo",
    "UserName": "y7tWD/YwyIs3ae+elTeoag==",
    "Password": "WebKLMXQd2DQnNlHImwQeQ=="
  },
  "WindowsServiceDependencies": [
    "_Redis_8012",
    "RabbitMQ"
  ],
  // Cấu hình có lưu body không
  "Logging": {
    "Provider": "Serilog",
    "LogRequestBody": true,
    "LogResponseBody": true,
    "LogSuccessResponse": true,
    "LogFailedResponse": true,
    "MaxBodyLength": 5000
  }
