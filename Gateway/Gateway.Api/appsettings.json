{
  // Cấu hình chung cho ứng dụng
  "AllowedHosts": "*",
  // Thông tin về ứng dụng, có thể được sử dụng trong log để phân biệt giữa các service
  "Application": {
    "ApplicationId": "Gateway",
    "ApplicationName": "Base Repo Gateway",
    "Version": "1.0.0",
    "AccessKey": "BaseRepo__JWT__AccessKey",
    "RefreshKey": "BaseRepo__JWT__RefreshKey",
    "Audience": "BaseRepo__JWT__Audience",
    "Issuer": "BaseRepo__JWT__Issuer",
    "PrivateKey": "BaseRepo__PrivateKey",
    "PublicKey": "BaseRepo__PublicKey",

    // Cấu hình kết nối đến Redis
    "RedisConnectionString": "localhost:8012,abortConnect=false,connectTimeout=5000",
    // Cấu hình kết nối đến RabbitMQ, phục vụ cho việc gửi và nhận message giữa các service
    "RabbitMqConnectionString": "amqp://guest:guest@localhost:8013/"
  },
  // Cấu hình kết nối đến Consul để đăng ký service và health check
  "Consul": {
    "Host": "http://localhost:8000",
    "ServiceName": "gateway-service",
    "ServiceId": "gateway-service-01",
    "ServiceIP": "localhost",
    "ServicePort": 80,
    "HealthCheckUrl": "http://localhost:80/health"
  },
  // Cấu hình kết nối đến SQL Server
  "ConnectionInfo": {
    "Host": "localhost,1433",
    "Database": "BaseRepo",
    "UserName": "GtaKIbrsY4Z7ebPCkH4Dkw==",
    "Password": "JbimeBVIWAdCFZUVs7lhgQ=="
  },
  "WindowsServiceDependencies": [
    "_Redis_8012",
    "RabbitMQ"
  ],
  // Cấu hình có lưu body không
  "Logging": {
    "Provider": "Serilog",
    "LogRequestBody": true,
    "LogResponseBody": true,
    "LogSuccessResponse": true,
    "LogFailedResponse": true,
    "MaxBodyLength": 5000
  },
  // Cấu hình YARP để định tuyến các request đến các service con
  "ReverseProxy": {
    "Routes": {
      "site-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "api/site/{**catch-all}" }
      },
      "module-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/module/{**catch-all}" }
      },
      "role-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/role/{**catch-all}" }
      },
      "function-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/function/{**catch-all}" }
      },
      "role-function-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/role-function/{**catch-all}" }
      },
      "screen-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/screen/{**catch-all}" }
      },
      "user-role-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/user-role/{**catch-all}" }
      },
      // "user-site-route" ĐÃ XOÁ - UserSiteController/tbl_User_Site đã bị gỡ bỏ hoàn toàn (User giờ chỉ thuộc
      // đúng 1 Site, gắn thẳng tbl_Users.SiteId, không còn quan hệ N-N để quản lý qua API riêng). Xem
      // CommonLibs/BaseSQL/multi-tenant/README.md.
      "permission-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/permission/{**catch-all}" }
      },
      // tbl_Site_Module (SiteModuleController) - CHỦ Ý chỉ mở đúng 2 route "my" và "toggle" ra Gateway công khai,
      // KHÔNG dùng {**catch-all} như các entity khác. 2 action còn lại của controller này (provision, xem theo
      // 1 SiteId bất kỳ) là API nội bộ cho đội vận hành - cố tình không có route YARP nên không gọi được qua
      // Gateway, chỉ gọi trực tiếp vào cổng nội bộ của Site service. Xem SiteModuleController.cs.
      "site-module-my-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/site-module/my", "Methods": [ "GET" ] }
      },
      "site-module-toggle-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/site-module/toggle", "Methods": [ "PUT" ] }
      },
      "site-swagger-route": {
        "ClusterId": "site-cluster",
        "Match": { "Path": "/site-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      // Province/Ward là dữ liệu hành chính công khai (tên tỉnh/phường) - API đọc (GET) cho phép
      // Anonymous để FE lấy dropdown địa chỉ mà không cần token. Vì AuthorizationPolicy của YARP
      // chặn ngay tại Gateway trước khi forward xuống service, phải tách route GET (không Policy)
      // và route mutating (Policy UserOrAdminPolicy) theo Methods, không thể dùng chung 1 route
      // như các entity khác.
      "province-read-route": {
        "ClusterId": "administrativeunit-cluster",
        "Match": { "Path": "/api/province/{**catch-all}", "Methods": [ "GET" ] }
      },
      "province-write-route": {
        "ClusterId": "administrativeunit-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/province/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] }
      },
      "ward-read-route": {
        "ClusterId": "administrativeunit-cluster",
        "Match": { "Path": "/api/ward/{**catch-all}", "Methods": [ "GET" ] }
      },
      "ward-write-route": {
        "ClusterId": "administrativeunit-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "/api/ward/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] }
      },
      "administrativeunit-swagger-route": {
        "ClusterId": "administrativeunit-cluster",
        "Match": { "Path": "/administrativeunit-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "site-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:8001/" } }
      },
      "administrativeunit-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:8002/" } }
      }
    }
  },

  // Cấu hình danh sách các tài liệu hiển thị trên Gateway
  "MicroservicesSwagger": {
    "Docs": [
      {
        "Name": "site-service",
        "Title": "Site Management API",
        "Url": "/site-swagger/v1/swagger.json"
      },
      {
        "Name": "auth-service",
        "Title": "Authentication API",
        "Url": "/auth-swagger/v1/swagger.json"
      },
      {
        "Name": "administrativeunit-service",
        "Title": "Administrative Unit API",
        "Url": "/administrativeunit-swagger/v1/swagger.json"
      }
    ]
  }
}
