{
  "AllowedHosts": "*",
  "Application": {
    "ApplicationId": "BaseRepo",
    "ApplicationName": "Base Repo",
    "Version": "1.0.0"
  },
  "ConnectionInfo": {
    "Host": "localhost,1433",
    "Database": "BaseRepo",
    "UserName": "No7mEf0EsVw8EJftOfOGZg==",
    "Password": "zEVpxpIlaePNhZyGDA3AEQ=="
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning", // Giảm bớt log hệ thống của Microsoft
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/gateway_log-.txt", // Đường dẫn thư mục Logs/log-20260519.txt
          "rollingInterval": "Day", // Tự động tạo file mới mỗi ngày
          "retainedFileCountLimit": 30, // Giữ lại log của tối đa 30 ngày gần nhất
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "Gateway-Service" // Thay đổi tên tương ứng với từng Project
    }
  },
  "ReverseProxy": {
    "Routes": {
      "site-route": {
        "ClusterId": "site-cluster",
        "Match": { "Path": "/site/{**catch-all}" }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      // Thêm 2 route này để YARP cho phép Gateway truy cập vào file JSON swagger của service con
      "site-swagger-route": {
        "ClusterId": "site-cluster",
        "Match": { "Path": "/site-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "auth-swagger-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "site-cluster": {
        "Destinations": { "destination1": { "Address": "https://localhost:7001/" } }
      },
      "auth-cluster": {
        "Destinations": { "destination1": { "Address": "https://localhost:7002/" } }
      }
    }
  },

  // Cấu hình danh sách các tài liệu hiển thị trên Gateway
  "MicroservicesSwagger": {
    "Docs": [
      {
        "Name": "site-service",
        "Title": "Site Management API",
        "Url": "/site-swagger/v1/swagger.json"
      },
      {
        "Name": "auth-service",
        "Title": "Authentication API",
        "Url": "/auth-swagger/v1/swagger.json"
      }
    ]
  }
}
