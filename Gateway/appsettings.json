{
  // Cấu hình chung cho ứng dụng
  "AllowedHosts": "*",
  // Thông tin về ứng dụng, có thể được sử dụng trong log để phân biệt giữa các service
  "Application": {
    "ApplicationId": "BaseRepo",
    "ApplicationName": "Base Repo",
    "Version": "1.0.0",
    "AccessToken": "BaseRepo__JWT__AccessKey",
    "RefreshToken": "BaseRepo__JWT__RefreshKey",
    "Audience": "BaseRepo__JWT__Audience",
    "Issuer": "BaseRepo__JWT__Issuer",
    "PrivateKey": "BaseRepo__PrivateKey",
    "PublicKey": "BaseRepo__PublicKey",

    // Cấu hình kết nối đến Redis
    "RedisConnectionString": "localhost:8012,abortConnect=false,connectTimeout=5000",
    // Cấu hình kết nối đến RabbitMQ, phục vụ cho việc gửi và nhận message giữa các service
    "RabbitMqConnectionString": "amqp://guest:guest@localhost:8013/"
  },
  // Cấu hình kết nối đến Consul để đăng ký service và health check
  "Consul": {
    "Host": "http://localhost:8000",
    "ServiceName": "gateway-service",
    "ServiceId": "gateway-service-01",
    "ServiceIP": "localhost",
    "ServicePort": 80,
    "HealthCheckUrl": "http://localhost:80/health"
  },
  // Cấu hình kết nối đến SQL Server
  "ConnectionInfo": {
    "Host": "localhost,1433",
    "Database": "BaseRepo",
    "UserName": "WxAm8oIlj5JfKS78NvxMGg==",
    "Password": "1/bAlaTMy1lJZkLOEaNuDg=="
  },
  "GatewayServiceDependencies": [
    "Redis"
  ],
  // Cấu hình Serilog để ghi log vào file
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning", // Giảm bớt log hệ thống của Microsoft
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      // 1. Ghi log ra Console để dev dễ nhìn khi chạy local
      {
        "Name": "Console",
        "Args": {
          // Định dạng màu sắc và cấu trúc hiển thị trên Console (Dễ đọc hơn JSON thô)
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console" // Thêm màu sắc cho chữ
        }
      },
      // 2. Ghi log ra File dạng JSON
      {
        "Name": "File",
        "Args": {
          // Nếu muốn ghi log dưới dạng JSON, hãy bỏ comment dòng formatter và comment dòng outputTemplate
          //"formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact", // Ghi log dưới dạng JSON để dễ dàng phân tích và tìm kiếm
          "path": "Logs/gateway_log-.json", // Đường dẫn thư mục Logs/log-20260519.txt
          "rollingInterval": "Day", // Tự động tạo file mới mỗi ngày
          "retainedFileCountLimit": 30, // Giữ lại log của tối đa 30 ngày gần nhất
          // dùng khi không áp dụng elasticsearch
          //"outputTemplate": "[{Timestamp:dd-MM-yyyy HH:mm:ss} {Level:u3}] [{Application}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {@t: UtcDateTime(@t), LocalTime: @p['LocalTime'], @l: @l, Application: @p['Application'], CorrelationId: @p['CorrelationId'], Message: @m, Exception: @x, Properties: Rest()} }\n"
          }
        }
      }
    ],
    // Thêm thông tin ứng dụng vào log để dễ dàng phân biệt giữa các service
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "Gateway-Service" // Thay đổi tên tương ứng với từng Project
    }
  },
  // Cấu hình có lưu body không
  "Logging": {
    "Provider": "Serilog",
    "LogRequestBody": true,
    "LogResponseBody": true,
    "LogSuccessResponse": true,
    "LogFailedResponse": true,
    "MaxBodyLength": 5000
  },
  // Cấu hình YARP để định tuyến các request đến các service con
  "ReverseProxy": {
    "Routes": {
      "site-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "api/site/{**catch-all}" }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "api/authorization/{**catch-all}" }
      },
      "user-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "UserOrAdminPolicy",
        "Match": { "Path": "api/user/{**catch-all}" }
      },
      "site-swagger-route": {
        "ClusterId": "site-cluster",
        "Match": { "Path": "/site-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "auth-swagger-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth-swagger/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "site-cluster": {
        "Destinations": { "destination1": { "Address": "https://localhost:8001/" } }
      },
      "auth-cluster": {
        "Destinations": { "destination1": { "Address": "https://localhost:8002/" } }
      }
    }
  },

  // Cấu hình danh sách các tài liệu hiển thị trên Gateway
  "MicroservicesSwagger": {
    "Docs": [
      {
        "Name": "site-service",
        "Title": "Site Management API",
        "Url": "/site-swagger/v1/swagger.json"
      },
      {
        "Name": "auth-service",
        "Title": "Authentication API",
        "Url": "/auth-swagger/v1/swagger.json"
      }
    ]
  }
}
