{
  // Cấu hình chung cho ứng dụng
  "AllowedHosts": "*",
  // Thông tin về ứng dụng, có thể được sử dụng trong log để phân biệt giữa các service
  "Application": {
    "ApplicationId": "BaseRepo",
    "ApplicationName": "Base Repo",
    "Version": "1.0.0"
  },
  // Cấu hình kết nối đến SQL Server
  "ConnectionInfo": {
    "Host": "localhost,1433",
    "Database": "BaseRepo",
    "UserName": "No7mEf0EsVw8EJftOfOGZg==",
    "Password": "zEVpxpIlaePNhZyGDA3AEQ=="
  },
  // Cấu hình kết nối đến Redis, có thể được sử dụng cho caching hoặc session management
  "RedisInfo": {
    "ServiceName": "Redis", // Thêm tên Windows Service của Redis vào đây
    "Description": "Base Repo Redis",
    "Host": "localhost",
    "Port": 8003,
    "Password": "", // Điền password nếu có
    "DefaultDatabase": 0
    // Chuỗi kết nối hoàn chỉnh phục vụ cho StackExchange.Redis nếu cần: "localhost:8003,password=..."
    //"ConnectionString": "localhost:8003,abortConnect=false,connectTimeout=5000"
  },
  // Cấu hình kết nối đến RabbitMQ, phục vụ cho việc gửi và nhận message giữa các service
  "RabbitMqInfo": {
    "ServiceName": "RabbitMQ",
    "Description": "Base Repo RabbitMQ",
    "Host": "localhost",
    "Port": 8004,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    // Cấu hình nâng cao cho MassTransit hoặc RabbitMQ Client nếu cần
    "HeartbeatInterval": 60
  },
  "GatewayServiceDependencies": [
    "Redis"
  ],
  // Cấu hình Serilog để ghi log vào file
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning", // Giảm bớt log hệ thống của Microsoft
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      // 1. Ghi log ra Console để dev dễ nhìn khi chạy local
      {
        "Name": "Console",
        "Args": {
          // Định dạng màu sắc và cấu trúc hiển thị trên Console (Dễ đọc hơn JSON thô)
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console" // Thêm màu sắc cho chữ
        }
      },
      // 2. Ghi log ra File dạng JSON
      {
        "Name": "File",
        "Args": {
          // Nếu muốn ghi log dưới dạng JSON, hãy bỏ comment dòng formatter và comment dòng outputTemplate
          //"formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact", // Ghi log dưới dạng JSON để dễ dàng phân tích và tìm kiếm
          "path": "Logs/site_log-.txt", // Đường dẫn thư mục Logs/log-20260519.txt
          "rollingInterval": "Day", // Tự động tạo file mới mỗi ngày
          "retainedFileCountLimit": 30, // Giữ lại log của tối đa 30 ngày gần nhất
          // dùng khi không áp dụng elasticsearch
          "outputTemplate": "[{Timestamp:dd-MM-yyyy HH:mm:ss} {Level:u3}] [{Application}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    // Thêm thông tin ứng dụng vào log để dễ dàng phân biệt giữa các service
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "Gateway-Service" // Thay đổi tên tương ứng với từng Project
    }
  },
  // Cấu hình có lưu body không
  "Logging": {
    "LogRequestBody": true,
    "LogResponseBody": true,
    "LogSuccessResponse": true,
    "LogFailedResponse": true,
    "MaxBodyLength": 5000
  },

  // Cấu hình danh sách các tài liệu hiển thị trên Gateway
  "MicroservicesSwagger": {
    "Docs": [
      {
        "Name": "site-service",
        "Title": "Site Management API",
        "Url": "/site-swagger/v1/swagger.json"
      },
      {
        "Name": "auth-service",
        "Title": "Authentication API",
        "Url": "/auth-swagger/v1/swagger.json"
      }
    ]
  }
}
