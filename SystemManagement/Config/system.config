<?xml version="1.0" encoding="utf-8" ?>
<systemConfig>
	<envKeys>
		<envKey>BaseRepo__JWT__AccessKey</envKey>
		<envKey>BaseRepo__JWT__RefreshKey</envKey>
		<envKey>BaseRepo__JWT__AudienceKey</envKey>
		<envKey>BaseRepo__JWT__IssuerKey</envKey>
		<envKey>BaseRepo__PrivateKey</envKey>
		<envKey>BaseRepo__PublicKey</envKey>
	</envKeys>
	<connections>
		<connection name="CenterConnection">
			<host></host>
			<database></database>
			<username></username>
			<password></password>
			<trustCertifficate></trustCertifficate>
		</connection>
	</connections>
	<sites>
		<site name="LMT">
			<modules>
				<module name="Gateway">
					<folderPath></folderPath>
					<configurationPath></configurationPath>
					<configurationFileType></configurationFileType>
					<iisName></iisName>
					<iisPort></iisPort>
				</module>
			</modules>
		</site>
	</sites>
</systemConfig>